#define COMBO_TERM_MS 110 // Default: 50
#define COMBO_IDLE_MS 150 // Default: disabled


/* Left hand - Horizontal */

ZMK_COMBO(left_ag_escape_combo, &ht_rgkp_kp ESCAPE ESCAPE, 30 31, ALL, COMBO_TERM_MS) // No prior idle
ZMK_COMBO(left_rg_nubs_combo, &ht_kp_rgkp RG(RS(NUBS)) NUBS, 31 32, ALL, COMBO_TERM_MS, COMBO_IDLE_MS)

ZMK_COMBO(left_ra_nubs_combo, &ht_kp_rakp RA(RS(NUBS)) NUBS, 48 49, ALL, COMBO_TERM_MS, COMBO_IDLE_MS)
ZMK_COMBO(left_rc_nubs_combo, &ht_kp_rckp RC(RS(NUBS)) NUBS, 49 50, ALL, COMBO_TERM_MS, COMBO_IDLE_MS)


/* Right hand - Horizontal */

ZMK_COMBO(right_lg_space_combo, &ht_kp_kp LC(LA(LG(SPACE))) LG(SPACE), 41 42 43, ALL, COMBO_TERM_MS, COMBO_IDLE_MS)

ZMK_COMBO(right_rg_nubs_combo, &ht_kp_rgkp RG(RS(NUBS)) NUBS, 41 42, DEFAULT, COMBO_TERM_MS, COMBO_IDLE_MS) // DEFAULT because of numberpad
ZMK_COMBO(right_ag_return_combo, &ht_rgkp_kp ESCAPE ESCAPE, 42 43, ALL, COMBO_TERM_MS) // No prior idle

ZMK_COMBO(right_rc_nubs_combo, &ht_kp_rckp RC(RS(NUBS)) NUBS, 55 56, DEFAULT, COMBO_TERM_MS, COMBO_IDLE_MS) // DEFAULT because of numberpad
ZMK_COMBO(right_ra_nubs_combo, &ht_kp_rakp RA(RS(NUBS)) NUBS, 56 57, DEFAULT, COMBO_TERM_MS, COMBO_IDLE_MS) // DEFAULT because of numberpad
