#include "config.dtsi"

// Make sure that there are no other imports, otherwise the config will be overwritten (e.g., behavior reconfigurations)
/ {
  keymap {
    compatible = "zmk,keymap";

    default {
      bindings = <
        &backtick_morph     &n1_morph           &n2_morph      &quick_hold_tap LBRC N3         &ad_n4                            &n5_morph   &kp LG(X)                                                                                                                 &none         &n6_morph   &n7_morph       &quick_hold_tap LPAR N8   &ad_n9                      &n0_morph        &plus_morph
        &underscore_morph   &kp Q               &kp W          &kp E                           &kp R                             &kp T       &kp LG(C)                                                                                                                 &kp LS(TAB)   &kp Y       &kp U           &kp I                     &kp O                       &kp P            &apostrophe_morph
