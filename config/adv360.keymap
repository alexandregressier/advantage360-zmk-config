#include "config.dtsi"
// Make sure that there are no other imports, otherwise the config will be overwritten (e.g., behavior reconfigurations)

/ {
    keymap {
        compatible = "zmk,keymap";

        default {
            bindings =<
&backtick_morph       &n1_morph     &n2_morph    &n3_morph    &n4_morph      &n5_morph  &kp LG(X)                                                                  &none        &n6_morph  &n7_morph      &n8_morph     &n9_morph    &n0_morph       &plus_morph
&underscore_morph     &kp Q         &kp W        &kp E        &kp R          &kp T      &kp LG(C)                                                                  &kp LS(TAB)  &kp Y      &kp U          &kp I         &kp O        &kp P           &minus_morph
&double_quotes_morph  &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHIFT F  &kp G      &kp LG(V)      &kp LG(NUBS)  &kp LC(NUBS)      &kp RC(NUBS)  &kp RG(NUBS)  &kp TAB      &kp H      &hmr RSHIFT J  &hmr RGUI K   &hmr RALT L  &hmr RCTRL ESC  &apostrophe_morph
&colon_morph          &kp Z         &kp X        &kp C        &kp V          &kp B                                   &sl SYMBOLS       &sl SYMBOLS                              &kp N      &kp M          &comma_morph  &dot_morph   &slash_morph    &equal_morph
&mo MOD               &none         &none        &left_morph  &up_morph                 &kp BACKSPACE  &smart_shift  &kp LA(NUBS)      &kp RA(NUBS)  &kp ENTER     &kp SPACE               &down_morph    &right_morph  &none        &none           &mo MOD
            >;
        };

        numbers {
            bindings = <
&trans       &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &u_euro          &kp KP_EQUAL       &kp KP_LEFT_PARENTHESIS  &kp KP_RIGHT_PARENTHESIS  &trans         &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &kp DOLLAR       &kp KP_N7          &kp KP_N8                &kp KP_N9                 &kp PERCENT    &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans  &kp KP_MINUS     &hmr RSHIFT KP_N4  &hmr RGUI KP_N5          &hmr RALT KP_N6           &kp KP_PLUS    &trans
&to DEFAULT  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                     &kp KP_MULTIPLY  &kp KP_N1          &kp KP_N2                &kp KP_N3                 &kp KP_DIVIDE  &trans
&trans       &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &kp KP_N0  &trans                   &none              &kp KP_COMMA             &kp KP_DOT                &trans         &trans
            >;
        };

        symbols {
            bindings = <
&trans                  &trans            &trans            &trans         &trans       &trans  &trans                                      &trans  &trans  &trans             &fr_i_diaeresis   &trans            &trans  &trans
&trans                  &fr_a_circumflex  &fr_e_circumflex  &fr_e_acute    &fr_e_grave  &trans  &trans                                      &trans  &trans  &fr_u_circumflex   &fr_i_circumflex  &fr_o_circumflex  &trans  &trans
&u_double_quotes_morph  &fr_a_grave       &trans            &trans         &trans       &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &m_fr_ou           &trans            &trans            &trans  &u_single_quote_morph
&trans                  &trans            &trans            &fr_c_cedilla  &trans       &trans                  &trans      &trans                  &trans  &trans             &trans            &trans            &trans  &trans
&trans                  &trans            &trans            &trans         &trans               &trans  &trans  &trans      &trans  &trans  &trans          &trans             &trans            &trans            &trans  &trans
            >;
        };

