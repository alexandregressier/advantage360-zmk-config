#include "config.dtsi"

// Make sure that there are no other imports, otherwise the config will be overwritten (e.g., behavior reconfigurations)
/ {
  keymap {
    compatible = "zmk,keymap";

    default {
      bindings = <
        &smart_fun FUNCTION 0   &ak_n1      &ak_n2     &ak_n3      &ak_n4    &ak_n5   &none                                                                                                                                              &none                   &ak_n6   &ak_n7     &ak_n8      &ak_n9      &ak_n0      &smart_fun FUNCTION 0
        &ak_backslash           &ak_q       &ak_w      &ak_e       &ak_r     &ak_t    &none                                                                                                                                              &kp LG(RIGHT_BRACKET)   &ak_y    &ak_u      &ak_i       &ak_o       &ak_p       &ak_semicolon
        &ak_double_quotes       &ak_a       &ak_s      &ak_d       &ak_f     &ak_g    &none                                     &none                   &none      &none           &none                                                 &kp LG(LEFT_BRACKET)    &ak_h    &ak_j      &ak_k       &ak_l       &ak_colon   &ak_single_quote
        &smart_num NUMBERS 0    &ak_z       &ak_x      &ak_c       &ak_v     &ak_b                                                                      &none      &none                                                                                         &ak_n    &ak_m      &ak_comma   &ak_dot     &ak_slash   &ak_minus
