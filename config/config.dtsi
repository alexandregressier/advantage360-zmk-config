/* Mods Row */

#define PRESERVE_ADAPTIVE_MODIFIERS_MS 500

#define PRESERVE_ADAPTIVE_MODIFIERS(KEY, TRIGGER_KEY, TRIGGER_KEY_LOWER) \
	ls_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(TRIGGER_KEY)>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(KEY)>; strict-modifiers; }; \
	lg_ ## TRIGGER_KEY_LOWER { trigger-keys = <LG(TRIGGER_KEY)>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LG(KEY)>; strict-modifiers; }; \
	la_ ## TRIGGER_KEY_LOWER { trigger-keys = <LA(TRIGGER_KEY)>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LA(KEY)>; strict-modifiers; }; \
	lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LC(TRIGGER_KEY)>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LC(KEY)>; strict-modifiers; }; \
	ls_lg_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LG(TRIGGER_KEY))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LG(KEY))>; strict-modifiers; }; \
	ls_la_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LA(TRIGGER_KEY))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LA(KEY))>; strict-modifiers; }; \
	ls_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LC(TRIGGER_KEY))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LC(KEY))>; strict-modifiers; }; \
	lg_la_ ## TRIGGER_KEY_LOWER { trigger-keys = <LG(LA(TRIGGER_KEY))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LG(LA(KEY))>; strict-modifiers; }; \
	lg_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LG(LC(TRIGGER_KEY))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LG(LC(KEY))>; strict-modifiers; }; \
	la_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LA(LC(TRIGGER_KEY))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LA(LC(KEY))>; strict-modifiers; }; \
	ls_lg_la_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LG(LA(TRIGGER_KEY)))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LG(LA(KEY)))>; strict-modifiers; }; \
	ls_lg_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LG(LC(TRIGGER_KEY)))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LG(LC(KEY)))>; strict-modifiers; }; \
	ls_la_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LA(LC(TRIGGER_KEY)))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LA(LC(KEY)))>; strict-modifiers; }; \
	lg_la_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LG(LA(LC(TRIGGER_KEY)))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LG(LA(LC(KEY)))>; strict-modifiers; }; \
	ls_lg_la_lc_ ## TRIGGER_KEY_LOWER { trigger-keys = <LS(LG(LA(LC(TRIGGER_KEY))))>; max-prior-idle-ms = <PRESERVE_ADAPTIVE_MODIFIERS_MS>; bindings = <&kp LS(LG(LA(LC(KEY))))>; strict-modifiers; };

// Left
ZMK_ADAPTIVE_KEY(ag_left,
	bindings = <&hml LCTRL LEFT>;
	PRESERVE_ADAPTIVE_MODIFIERS(LEFT, LEFT, left)
	PRESERVE_ADAPTIVE_MODIFIERS(LEFT, RIGHT, right)
	PRESERVE_ADAPTIVE_MODIFIERS(LEFT, DOWN, down)
	PRESERVE_ADAPTIVE_MODIFIERS(LEFT, UP, up)
)
// Right
ZMK_ADAPTIVE_KEY(ag_right,
	bindings = <&hmr LALT RIGHT>;
	PRESERVE_ADAPTIVE_MODIFIERS(RIGHT, LEFT, left)
	PRESERVE_ADAPTIVE_MODIFIERS(RIGHT, RIGHT, right)
	PRESERVE_ADAPTIVE_MODIFIERS(RIGHT, DOWN, down)
	PRESERVE_ADAPTIVE_MODIFIERS(RIGHT, UP, up)
)


// Tab
ZMK_ADAPTIVE_KEY(ag_tab,
	bindings = <&hml LGUI TAB>;
	PRESERVE_ADAPTIVE_MODIFIERS(TAB, TAB, tab)
)

// Down
ZMK_ADAPTIVE_KEY(ag_down,
	bindings = <&hmr LGUI DOWN>;
	PRESERVE_ADAPTIVE_MODIFIERS(DOWN, LEFT, left)
	PRESERVE_ADAPTIVE_MODIFIERS(DOWN, RIGHT, right)
	PRESERVE_ADAPTIVE_MODIFIERS(DOWN, DOWN, down)
	PRESERVE_ADAPTIVE_MODIFIERS(DOWN, UP, up)
)
// Up
ZMK_ADAPTIVE_KEY(ag_up,
	bindings = <&hmr LALT UP>;
	PRESERVE_ADAPTIVE_MODIFIERS(UP, LEFT, left)
	PRESERVE_ADAPTIVE_MODIFIERS(UP, RIGHT, right)
	PRESERVE_ADAPTIVE_MODIFIERS(UP, DOWN, down)
	PRESERVE_ADAPTIVE_MODIFIERS(UP, UP, up)
)
// Shift + Tab
ZMK_ADAPTIVE_KEY(ag_lstab,
	bindings = <&hml LCTRL LS(TAB)>;
)


/* Numpad */ // Numpad instead of keypad because it abbreviates kp as well

// aq = adaptive quit
#define MAKE_NUMPAD_KEY(NUMBER, BEHIND_KEY) \
	ZMK_ADAPTIVE_KEY(aq_np ## NUMBER ##, \
		bindings = <&np ## NUMBER ## _morph>; \
	) \
	ZMK_MOD_MORPH(np ## NUMBER ## _morph, \
		bindings = <&ht_kp_kp BEHIND_KEY N ## NUMBER>, <&ht_kp_kp BEHIND_KEY N ## NUMBER>; \
		mods = <(MOD_RSFT)>; \
	)

MAKE_NUMPAD_KEY(1, M)
MAKE_NUMPAD_KEY(2, COMMA)
MAKE_NUMPAD_KEY(3, DOT)
MAKE_NUMPAD_KEY(4, J)
MAKE_NUMPAD_KEY(5, K)
MAKE_NUMPAD_KEY(6, L)
MAKE_NUMPAD_KEY(7, U)
MAKE_NUMPAD_KEY(8, I)
MAKE_NUMPAD_KEY(9, O)


/* Smart Shift */

#define MAKE_SMART_SHIFT(NAME, SHIFT_KEY) \
	ZMK_ADAPTIVE_KEY(NAME, \
		bindings = <&ht_kp_ ## SHIFT_KEY ## _dance SHIFT_KEY SHIFT_KEY>; \
	) \
	ZMK_HOLD_TAP(ht_kp_ ## SHIFT_KEY ## _dance, \
		flavor = "balanced"; \
		tapping-term-ms = <200>; \
		quick-tap-ms = <QUICK_TAP_MS>; \
		bindings = <&kp>, <&sk>; \
	)

MAKE_SMART_SHIFT(smart_lshift, LEFT_SHIFT)
MAKE_SMART_SHIFT(smart_rshift, RIGHT_SHIFT)

&caps_word {
	/delete-property/ ignore-modifiers;
};


