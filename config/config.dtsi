// U
MAKE_LETTER_KEY(U, u)
// I
MAKE_LETTER_KEY(I, i)
// O
MAKE_LETTER_KEY(O, o)
// P
MAKE_LETTER_KEY(P, p, sht_rgkp_kp) // Slow because misfires

// Backslash
ZMK_ADAPTIVE_KEY(ag_backslash,
	bindings = <&backslash_morph>;
)
ZMK_MOD_MORPH(backslash_morph,
	bindings = <&ht_rgkp_kp BACKSLASH BACKSLASH>, <&ht_rgkp_ueuro RS(BACKSLASH) 0>;
	mods = <(MOD_RSFT)>;
)
TAP_PREFERRED_HOLD_TAP(ht_rgkp_ueuro, &rgkp, &u_euro)


/* Middle Row */

// Double quotes
ZMK_ADAPTIVE_KEY(ag_double_quotes,
	bindings = <&double_quotes_morph>;
)
ZMK_MOD_MORPH(double_quotes_morph,
	bindings = <&ht_rgkp_kp DOUBLE_QUOTES DOUBLE_QUOTES>, <&ht_rgkp_mcurlydoublequotespair RS(DOUBLE_QUOTES) 0>;
	mods = <(MOD_RSFT)>;
)
TAP_PREFERRED_HOLD_TAP(ht_rgkp_mcurlydoublequotespair, &rgkp, &u_left_curly_double_quotes)
//SIMPLE_MACRO(m_curly_double_quotes_pair, &u_left_curly_double_quotes &u_right_curly_double_quotes &kp LEFT)

// A
MAKE_LETTER_KEY(A, a)
// S
MAKE_LETTER_KEY(S, s)
// D
MAKE_LETTER_KEY(D, d)
// F
MAKE_LETTER_KEY(F, f)
// G
MAKE_LETTER_KEY(G, g)


// H
MAKE_LETTER_KEY(H, h, ht_rgkp_kp,
	rg_h { trigger-keys = <RG(H)>; bindings = <&key_repeat>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; strict-modifiers; };
)
// J
MAKE_LETTER_KEY(J, j)
// K
MAKE_LETTER_KEY(K, k)
// L
MAKE_LETTER_KEY(L, l)
