// Colon
ZMK_MOD_MORPH(colon_morph,
	bindings = <&ht_rgkp_kp SEMICOLON COLON>, <&ht_rgkp_kp LS(SEMICOLON) SEMICOLON>;
	mods = <(MOD_LSFT)>;
)
ZMK_MOD_MORPH(colon_mod_morph,
	bindings = <&colon_morph>, <&ht_rgkp_kp SEMICOLON SEMICOLON>;
	mods = <(MOD_LGUI|MOD_LALT|MOD_LCTL)>;
	keep-mods = <(MOD_LGUI|MOD_LALT|MOD_LCTL)>;
)
ZMK_ADAPTIVE_KEY(ak_colon,
	bindings = <&colon_mod_morph>;
)
// Single quote
ZMK_MOD_MORPH(single_quote_morph,
	bindings = <&ht_rgkp_kp SINGLE_QUOTE SINGLE_QUOTE>, <&u_curly_apostrophe>;
	mods = <(MOD_LSFT)>;
)
ZMK_ADAPTIVE_KEY(ak_single_quote,
	bindings = <&single_quote_morph>;
)

