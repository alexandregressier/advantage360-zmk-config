	mods = <(MOD_LSFT)>;
)
// 0
ZMK_ADAPTIVE_KEY(ag_n0,
	bindings = <&n0_morph>;
)
ZMK_MOD_MORPH(n0_morph,
	bindings = <&ht_rgkp_kp N6 PLUS>, <&ht_rgkp_kp LS(N6) PLUS>;
	mods = <(MOD_LSFT)>;
)

