	mods = <(MOD_LSFT)>;
)

// 6
ZMK_ADAPTIVE_KEY(ag_n6,
	bindings = <&n6_morph>;
)
ZMK_MOD_MORPH(n6_morph,
	bindings = <&ht_rgkp_kp N7 UNDERSCORE>, <&ht_rgkp_kp LS(N7) UNDERSCORE>;
	mods = <(MOD_LSFT)>;
)
// 7
ZMK_ADAPTIVE_KEY(ag_n7,
	bindings = <&n7_morph>;
)
ZMK_MOD_MORPH(n7_morph,
	bindings = <&ht_rgkp_kp N9 MINUS>, <&ht_rgkp_kp LS(N9) LESS_THAN>;
	mods = <(MOD_LSFT)>;
)
// 8
ZMK_ADAPTIVE_KEY(ag_n8,
	bindings = <&n8_morph>;
	greater_than { trigger-keys = <MINUS EQUAL LESS_THAN>; bindings = <&ht_rgkp_kp N8 GREATER_THAN>; };
)
ZMK_MOD_MORPH(n8_morph,
