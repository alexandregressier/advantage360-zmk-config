/* Smart Shift */

ZMK_ADAPTIVE_KEY(smart_shift,
	bindings = <&ht_kp_shiftdance LEFT_SHIFT 0>;
)
ZMK_HOLD_TAP(ht_kp_shiftdance,
	flavor = "balanced";
	tapping-term-ms = <200>;
	quick-tap-ms = <QUICK_TAP_MS>;
	bindings = <&kp>, <&shift_dance>;
)
ZMK_TAP_DANCE(shift_dance,
	tapping-term-ms = <400>; // Max time between each step below (200 is too short)
	bindings = <&sk LEFT_SHIFT>, <&caps_word>, <&kp CAPSLOCK>;
)
&caps_word {
	/delete-property/ ignore-modifiers;
};


/* Smart Number */

ZMK_TAP_DANCE(num_dance,
	tapping-term-ms = <400>;
	bindings = <&num_word NUMBERS>, <&tog NUMBERS>;
)
ZMK_HOLD_TAP(smart_num,
	flavor = "balanced";
	tapping-term-ms = <200>;
	quick-tap-ms = <QUICK_TAP_MS>;
	bindings = <&mo>, <&num_dance>;
)
&num_word {
	ignore-modifiers; // Needed for shortcuts like
};


/* Smart Function */

ZMK_TAP_DANCE(fun_dance,
	tapping-term-ms = <400>;
	bindings = <&sl FUNCTION>, <&tog FUNCTION>;
)

ZMK_HOLD_TAP(smart_fun,
	flavor = "balanced";
	tapping-term-ms = <200>;
	quick-tap-ms = <QUICK_TAP_MS>;
	bindings = <&mo>, <&fun_dance>;
)
