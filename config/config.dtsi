ZMK_UNICODE_SINGLE(u_euro, N2, N0, A, C)  // € EURO SIGN (codepoint 8364, #o20254, #x20ac)


/* Custom Behaviors */

#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, \
        mods = <(MOD_L ## MOD|MOD_R ## MOD)>; \
        bindings = <BINDING1>, <BINDING2>; \
    )

// First Row
/// 1
SIMPLE_MORPH(tilde_morph, SFT, &kp TILDE, &kp TILDE)
/// 2
SIMPLE_MORPH(left_bracket_morph, SFT, &kp LEFT_BRACKET, &kp AT_SIGN)
/// 3
SIMPLE_MORPH(left_brace_morph, SFT, &kp LEFT_BRACE, &kp HASH)
/// 4
SIMPLE_MORPH(right_bracket_morph, SFT, &kp RIGHT_BRACKET, &kp DOLLAR)
/// 5
SIMPLE_MORPH(less_than_morph, SFT, &kp LESS_THAN, &kp PERCENT)
//SIMPLE_MACRO(m_less_than_or_equal, &kp LESS_THAN &kp EQUAL)
/// 6
SIMPLE_MORPH(greater_than_morph, SFT, &kp GREATER_THAN, &kp CARET)
//SIMPLE_MACRO(m_greater_than_or_equal, &kp GREATER_THAN &kp EQUAL)
/// 7
SIMPLE_MORPH(right_brace_morph, SFT, &kp RIGHT_BRACE, &kp AMPERSAND)
/// 8
SIMPLE_MORPH(left_parenthesis_morph, SFT, &kp LEFT_PARENTHESIS, &kp ASTERISK)
/// 9
SIMPLE_MORPH(right_parenthesis_morph, SFT, &kp RIGHT_PARENTHESIS, &kp PIPE)
/// 0
SIMPLE_MORPH(backslash_morph, SFT, &kp BACKSLASH, &kp BACKSLASH)

// Top Row
SIMPLE_MORPH(backtick_morph, SFT, &kp GRAVE, &m_triple_backticks)
SIMPLE_MACRO(m_triple_backticks, &kp GRAVE &kp GRAVE &kp GRAVE)

SIMPLE_MORPH(semicolon_morph, SFT, &kp SEMICOLON, &m_terminate_statement)
SIMPLE_MACRO(m_terminate_statement, &kp LG(RIGHT_ARROW) &kp SEMICOLON &kp RETURN)

// Middle Row
SIMPLE_MORPH(equal_morph, SFT, &kp EQUAL, &m_fat_arrow)
SIMPLE_MACRO(m_fat_arrow, &kp EQUAL &kp GREATER_THAN)

SIMPLE_MORPH(apostrophe_morph, SFT, &kp APOSTROPHE, &kp APOSTROPHE)

// Bottom Row
SIMPLE_MORPH(comma_morph, SFT, &kp COMMA, &u_interpunct)

SIMPLE_MORPH(dot_morph, SFT, &kp DOT, &u_ellipsis)

SIMPLE_MORPH(slash_morph, SFT, &kp SLASH, &kp SLASH)

SIMPLE_MORPH(double_quotes_morph, SFT, &kp DOUBLE_QUOTES, &kp DOUBLE_QUOTES)

// Last Row
SIMPLE_MORPH(plus_morph, SFT, &kp PLUS, &m_addition_assignment_operator)
SIMPLE_MACRO(m_addition_assignment_operator, &kp PLUS &kp EQUAL)

SIMPLE_MORPH(underscore_morph, SFT, &kp UNDERSCORE, &kp UNDERSCORE)

SIMPLE_MORPH(minus_morph, SFT, &kp MINUS, &m_thin_arrow)
SIMPLE_MACRO(m_thin_arrow, &kp MINUS &kp GREATER_THAN)

SIMPLE_MORPH(colon_morph, SFT, &kp COLON, &kp COLON)

SIMPLE_MORPH(question_morph, SFT, &kp QUESTION, &kp QUESTION)

SIMPLE_MORPH(exclamation_morph, SFT, &kp EXCLAMATION, &m_not_equal_to_operator)
SIMPLE_MACRO(m_not_equal_to_operator, &kp EXCLAMATION &kp EQUAL)


/* Homerow Mods */

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(hml, &kp, &kp, KEYS_RIGHT THUMBS_LEFT THUMBS_RIGHT) // Left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_LEFT THUMBS_LEFT THUMBS_RIGHT) // Right-hand HRMs

MAKE_HRM(hmr_end, &kp, &end_morph, KEYS_LEFT THUMBS_LEFT THUMBS_RIGHT)
SIMPLE_MORPH(end_morph, SFT, &kp LG(RIGHT_ARROW), &kp LG(DOWN_ARROW))

/* Smart Shift */

// Tap: sticky shift | Double-tap: caps-word | Hold: shift

ZMK_HOLD_TAP(smart_shift,
	flavor = "balanced";
	tapping-term-ms = <200>;
	quick-tap-ms = <QUICK_TAP_MS>;
	bindings = <&kp>, <&shift_dance>;
)

SIMPLE_MORPH(smart_shift_morph, SFT, &sk LEFT_SHIFT, &kp CAPSLOCK)

ZMK_TAP_DANCE(shift_dance,
    tapping-term-ms = <400>;
	bindings = <&smart_shift_morph>, <&caps_word>, <&kp CAPSLOCK>;
)
&caps_word {
	/delete-property/ ignore-modifiers;
};


/* Smart Number */

ZMK_TAP_DANCE(smart_num,
	tapping-term-ms = <400>;
	bindings = <&num_word NUMBERS>, <&tog NUMBERS>;
)
&num_word {
	ignore-modifiers; // Needed for shortcuts like
};


/* Hyper & Super */

ZMK_MACRO_ONE_PARAM(hyper_kp,
	wait-ms = <0>;
	tap-ms = <0>;
	bindings
	= <&macro_press &kp LG(LCTRL)> // More modifiers before: the next shortcuts are gated and cannot be triggered inadvertently
    , <&macro_param_1to1>
	, <&macro_tap &kp MACRO_PLACEHOLDER>
	, <&macro_release &kp LG(LCTRL)>
	, <&macro_tap &sl SUPER>
	;
)

ZMK_MACRO_ONE_PARAM(super_kp,
	wait-ms = <0>;
	tap-ms = <0>;
	bindings
	= <&macro_press &kp LCTRL>
	, <&macro_param_1to1>
	, <&macro_tap &kp MACRO_PLACEHOLDER>
	, <&macro_release &kp LCTRL>
	, <&macro_tap &to DEFAULT>
	;
)

ZMK_MACRO(cmd_space,
	wait-ms = <0>;
	tap-ms = <0>;
	bindings = <&kp LG(SPACE) &to DEFAULT>;
)


ZMK_MACRO_ONE_PARAM(wm_kp,
	wait-ms = <0>;
	tap-ms = <0>;
	bindings
	= <&macro_press &kp LGUI>
	, <&macro_param_1to1>
	, <&macro_tap &kp MACRO_PLACEHOLDER>
	, <&macro_release &kp LGUI>
	, <&macro_tap &to DEFAULT>
	;
)


/* Command Mode */

ZMK_MACRO_ONE_PARAM(kpi,
	wait-ms = <0>;
	tap-ms = <0>;
	bindings
	= <&macro_param_1to1>
    , <&kp MACRO_PLACEHOLDER &to DEFAULT>;
)
