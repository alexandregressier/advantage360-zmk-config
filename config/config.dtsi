/* Custom Behaviors */

#define MAKE_LETTER_KEY(...) CONCAT(MAKE_LETTER_KEY_, VARGS(__VA_ARGS__))(__VA_ARGS__)
#define MAKE_LETTER_KEY_2(KEY, KEY_LOWER) \
    MAKE_LETTER_KEY_3(KEY, KEY_LOWER, ht_rgkp_kp)
#define MAKE_LETTER_KEY_3(KEY, KEY_LOWER, BEHAVIOR) \
    MAKE_LETTER_KEY_4(KEY, KEY_LOWER, BEHAVIOR, )
#define MAKE_LETTER_KEY_4(KEY, KEY_LOWER, BEHAVIOR, LETTER_VAARGS) \
	ZMK_ADAPTIVE_KEY(ag_ ## KEY_LOWER, \
		bindings = <&BEHAVIOR KEY KEY>; \
		rs_ ## KEY_LOWER { trigger-keys = <RS(KEY)>; bindings = <&key_repeat>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; }; \
		LETTER_VAARGS \
	)

#define MAKE_NUMBER_ROW_KEY(...) CONCAT(MAKE_NUMBER_ROW_KEY_, VARGS(__VA_ARGS__))(__VA_ARGS__)
#define MAKE_NUMBER_ROW_KEY_6(NAME, NUMBER, KEY, KEY_LOWER, RS_KEY, RS_KEY_LOWER) \
    MAKE_NUMBER_ROW_KEY_7(NAME, NUMBER, KEY, KEY_LOWER, RS_KEY, RS_KEY_LOWER, )
#define MAKE_NUMBER_ROW_KEY_7(NAME, NUMBER, KEY, KEY_LOWER, RS_KEY, RS_KEY_LOWER, NUMBER_ROW_VAARGS) \
	ZMK_ADAPTIVE_KEY(NAME, \
		bindings = <&KEY_LOWER ## _shift_morph>; \
		rg_repeat { \
			trigger-keys = <RG(N1) RG(N2) RG(N3) RG(N4) RG(N5) RG(N6) RG(N7) RG(N8) RG(N9) RG(N0)>; \
			bindings = <&ht_rgkp_rgkp NUMBER NUMBER>; \
			max-prior-idle-ms = <SLOW_ADAPTIVE_TIMEOUT_MS>; \
		}; \
		NUMBER_ROW_VAARGS \
	) \
	ZMK_MOD_MORPH(KEY_LOWER ## _shift_morph, \
		bindings = <&ht_rgkp_kp NUMBER KEY>, <&ht_rgkp_kp RS(NUMBER) RS_KEY>; \
		mods = <(MOD_RSFT)>; \
	)
// Why <&ht_rgkp_rgkp NUMBER NUMBER>; ? Because a simple <&kp RG(NUMBER)> would be repeated while holding

#define MAKE_SPECIAL_CHAR_KEY(KEY, KEY_LOWER, RS_KEY, RS_KEY_LOWER, ORIGINAL_KEY) \
	ZMK_ADAPTIVE_KEY(ag_ ## KEY_LOWER, \
		bindings = <&KEY_LOWER ## _mods_morph>; \
		ag_ ## RS_KEY_LOWER { trigger-keys = <RS_KEY>; bindings = <&key_repeat>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; }; \
	) \
	ZMK_MOD_MORPH(KEY_LOWER ## _mods_morph, \
		bindings = <&KEY_LOWER ## _morph>, <&ht_rgkp_kp ORIGINAL_KEY ORIGINAL_KEY>; \
		mods = <(MOD_LSFT|MOD_LGUI|MOD_LALT|MOD_LCTL)>; \
		keep-mods = <(MOD_LSFT|MOD_LGUI|MOD_LALT|MOD_LCTL)>; \
	) \
	ZMK_MOD_MORPH(KEY_LOWER ## _morph, \
		bindings = <&ht_rgkp_kp KEY KEY>, <&ht_rgkp_kp RS(RS_KEY) RS_KEY>; \
		mods = <(MOD_RSFT)>; \
	)

/* Number Row */

// 1
MAKE_NUMBER_ROW_KEY(ag_n1, N5, CARET, caret, TILDE, tilde,
	tilde { trigger-keys = <TILDE>; bindings = <&kp TILDE>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// 2
MAKE_NUMBER_ROW_KEY(ag_n2, N3, LEFT_BRACKET, left_bracket, HASH, hash,
	hash { trigger-keys = <HASH>; bindings = <&key_repeat>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// 3
MAKE_NUMBER_ROW_KEY(ag_n3, N1, LEFT_BRACE, left_brace, RIGHT_BRACKET, right_bracket,
	right_bracket { trigger-keys = <LEFT_BRACKET RIGHT_BRACKET>; bindings = <&kp RIGHT_BRACKET>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// 4
MAKE_NUMBER_ROW_KEY(ag_n4, N2, QUESTION, question, RIGHT_BRACE, right_brace,
	right_brace { trigger-keys = <LEFT_BRACE RIGHT_BRACE>; bindings = <&kp RIGHT_BRACE>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// 5
MAKE_NUMBER_ROW_KEY(ag_n5, N4, BANG, bang, STAR, star, // `BANG` is deprecated but I’m a daredevil
	star { trigger-keys = <STAR>; bindings = <&kp STAR>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)


// 6
MAKE_NUMBER_ROW_KEY(ag_n6, N7, UNDERSCORE, underscore, AMPERSAND, ampersand,
	ampersand { trigger-keys = <AMPERSAND>; bindings = <&kp AMPERSAND>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; strict-modifiers; };
)
// 7
MAKE_NUMBER_ROW_KEY(ag_n7, N9, MINUS, minus, LESS_THAN, less_than,
	less_than { trigger-keys = <LESS_THAN GREATER_THAN>; bindings = <&kp LESS_THAN>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; strict-modifiers; };
)
// 8
MAKE_NUMBER_ROW_KEY(ag_n8, N0, LEFT_PARENTHESIS, left_parenthesis, GREATER_THAN, greater_than,
	greater_than { trigger-keys = <LESS_THAN GREATER_THAN MINUS EQUAL>; bindings = <&kp GREATER_THAN>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; strict-modifiers; };
)
// 9
MAKE_NUMBER_ROW_KEY(ag_n9, N8, EQUAL, equal, RIGHT_PARENTHESIS, right_parenthesis,
	right_parenthesis { trigger-keys = <LEFT_PARENTHESIS RIGHT_PARENTHESIS>; bindings = <&kp RIGHT_PARENTHESIS>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; strict-modifiers; };
)
// 0
MAKE_NUMBER_ROW_KEY(ag_n0, N6, PLUS, plus, PIPE, pipe,
	pipe { trigger-keys = <PIPE>; bindings = <&kp PIPE>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; strict-modifiers; };
)

