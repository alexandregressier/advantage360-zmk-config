	bindings = <&n3_morph>;
	right_bracket {
		trigger-keys = <LEFT_BRACKET RIGHT_BRACKET>;
		max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>;
		bindings = <&ht_rgkp_kp N3 RIGHT_BRACKET>;
	};
)
ZMK_MOD_MORPH(n3_morph,
	bindings = <&ht_rgkp_kp N1 LEFT_BRACE>, <&ht_rgkp_kp N1 RIGHT_BRACE>;
	mods = <(MOD_LSFT)>;
)
// 4
ZMK_ADAPTIVE_KEY(ag_n4,
	bindings = <&n4_morph>;
	right_brace {
		trigger-keys = <LEFT_BRACE RIGHT_BRACE>;
		max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>;
		bindings = <&ht_rgkp_kp N4 RIGHT_BRACE>;
	};
)
ZMK_MOD_MORPH(n4_morph,
	bindings = <&ht_rgkp_kp N2 LEFT_BRACKET>, <&ht_rgkp_kp N2 RIGHT_BRACE>;
	mods = <(MOD_LSFT)>;
)
// 5
ZMK_ADAPTIVE_KEY(ag_n5,
	bindings = <&n5_morph>;
)
ZMK_MOD_MORPH(n5_morph,
