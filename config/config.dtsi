MAKE_LETTER_KEY(Z, z) // No smart repeat because this isn't used as undo/redo

// X
MAKE_LETTER_KEY(X, x, ht_rgkp_kp,
	rg_x { trigger-keys = <RG(A) RG(X) RG(C) RG(V) LG(A) LG(X) LG(C) LG(V)>; bindings = <&ht_rgkp_kp X RG(X)>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// C
MAKE_LETTER_KEY(C, c, ht_rgkp_kp,
	rg_c { trigger-keys = <RG(A) RG(X) RG(C) RG(V) LG(A) LG(X) LG(C) LG(V)>; bindings = <&ht_rgkp_kp C RG(C)>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// V
MAKE_LETTER_KEY(V, v, ht_rgkp_kp,
	rg_v { trigger-keys = <RG(A) RG(X) RG(C) RG(V) LG(A) LG(X) LG(C) LG(V)>; bindings = <&ht_rgkp_kp V RG(V)>; max-prior-idle-ms = <DEFAULT_ADAPTIVE_TIMEOUT_MS>; allow-more-modifiers; };
)
// B
MAKE_LETTER_KEY(B, b)


// N
MAKE_LETTER_KEY(N, n)
